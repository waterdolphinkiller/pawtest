{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["./types"]
  },
  "include": ["src/**/*.js", "bin/**/*.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules", "output"]
}
